{
  "name": "fabricio-desktop",
  "description": "Fabricio Telas Desktop App",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "npx concurrently \"vite\" \"electron .\"",
    "rebuild": "node-gyp rebuild --target=31.3.1 --arch=x64 --dist-url=https://electronjs.org/headers",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "make": "npm run rebuild && npm run build && npm run dist"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.fabricio.telas",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "build/Release/audio_mixer.node"
    ]
  }
}
